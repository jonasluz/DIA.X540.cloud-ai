          <mxGeometry x="-10" y="28" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-38" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=0;" parent="GXKjekpxdG3pA_SLmEvS-39" source="GXKjekpxdG3pA_SLmEvS-29" target="GXKjekpxdG3pA_SLmEvS-37" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAEDED;fontSize=22;fontColor=#FFFFFF;strokeColor=none;labelBackgroundColor=none;container=1;" parent="1" vertex="1">
          <mxGeometry x="1190" y="208" width="539" height="749" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-5" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;" parent="7OVz4w7n9kzEPWy-4BBC-3" vertex="1">
          <mxGeometry x="19" y="80.38" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-14" value="For each user message during the conversation session, the client app records the user talk. In order to send the audio file to the backend, the client app first requires a S3 presigned upload URL where to send the audio file." style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="7OVz4w7n9kzEPWy-4BBC-3" vertex="1">
          <mxGeometry x="71" y="80.88" width="450" height="79.12" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-52" value="" style="group" parent="7OVz4w7n9kzEPWy-4BBC-3" vertex="1" connectable="0">
          <mxGeometry x="18" y="222" width="502" height="56.370000000000005" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-50" value="&lt;span&gt;In response to the user talk audio upload, the client app receives its S3 key. The client app asks for the transcription of the audio by calling /transcript/start.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="GXKjekpxdG3pA_SLmEvS-52" vertex="1">
          <mxGeometry x="52" width="450" height="56.37" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-51" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;" parent="GXKjekpxdG3pA_SLmEvS-52" vertex="1">
          <mxGeometry y="1.5" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-53" value="" style="group" parent="7OVz4w7n9kzEPWy-4BBC-3" vertex="1" connectable="0">
          <mxGeometry x="18" y="162" width="502" height="56.370000000000005" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-6" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;" parent="GXKjekpxdG3pA_SLmEvS-53" vertex="1">
          <mxGeometry y="1.5" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-15" value="&lt;span&gt;The S3 presigned upload URL is generated and informed to the client app, that uses it to directly send the recorded audio file of the user talk.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="GXKjekpxdG3pA_SLmEvS-53" vertex="1">
          <mxGeometry x="52" width="450" height="56.37" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-54" value="" style="group" parent="7OVz4w7n9kzEPWy-4BBC-3" vertex="1" connectable="0">
          <mxGeometry x="20" y="292" width="502" height="56.370000000000005" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-55" value="&lt;span&gt;The transcription job is started on AWS transcribe service. The name of the job is returned to the client app, so it can pools for it retrieval.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="GXKjekpxdG3pA_SLmEvS-54" vertex="1">
          <mxGeometry x="52" width="450" height="56.37" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-56" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;" parent="GXKjekpxdG3pA_SLmEvS-54" vertex="1">
          <mxGeometry y="1.5" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-58" value="" style="group" parent="7OVz4w7n9kzEPWy-4BBC-3" vertex="1" connectable="0">
          <mxGeometry x="20" y="352" width="500.5" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-9" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;" parent="GXKjekpxdG3pA_SLmEvS-58" vertex="1">
          <mxGeometry width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-18" value="&lt;span&gt;Once the audio transcription is completed, its result is saved in the S3 bucket in JSON format, which is retrieved by the client app as a result of pooling calls to /transcript/download.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="GXKjekpxdG3pA_SLmEvS-58" vertex="1">
          <mxGeometry x="50.5" y="1.5" width="450" height="58.5" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-59" value="" style="group" parent="7OVz4w7n9kzEPWy-4BBC-3" vertex="1" connectable="0">
          <mxGeometry x="20" y="422" width="500" height="78" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-10" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;" parent="GXKjekpxdG3pA_SLmEvS-59" vertex="1">
          <mxGeometry width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-19" value="&lt;span&gt;The client app sends the transcripted text of the user&#39;s call to the chat. The lambda function forward the user message to the model served in Amazon Bedrock, which returns the LLM response to the lambda function.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="GXKjekpxdG3pA_SLmEvS-59" vertex="1">
          <mxGeometry x="51" y="0.7358490566037735" width="449" height="77.26415094339622" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-60" value="" style="group" parent="7OVz4w7n9kzEPWy-4BBC-3" vertex="1" connectable="0">
          <mxGeometry x="18" y="502" width="499.5" height="63.5" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-11" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;" parent="GXKjekpxdG3pA_SLmEvS-60" vertex="1">
          <mxGeometry width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-20" value="&lt;span&gt;The LLM response, in text format, is sent to Amazon Polly for speech synthesis. The synthetized audio is returned to the lambda function that, then, saves it in the S3 bucket.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="GXKjekpxdG3pA_SLmEvS-60" vertex="1">
          <mxGeometry x="50.5" y="2.1166666666666667" width="449" height="61.38333333333334" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-65" value="" style="group" parent="7OVz4w7n9kzEPWy-4BBC-3" vertex="1" connectable="0">
          <mxGeometry x="18" y="29" width="500.5" height="38.5" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-4" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;" parent="GXKjekpxdG3pA_SLmEvS-65" vertex="1">
          <mxGeometry y="0.5" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-13" value="&lt;span&gt;The client endpoint application initiate the conversation session, which creates the session record in the DynamoDB.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="GXKjekpxdG3pA_SLmEvS-65" vertex="1">
          <mxGeometry x="51.5" width="449" height="37.5" as="geometry" />
        </mxCell>
