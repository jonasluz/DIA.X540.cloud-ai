        <mxCell id="GXKjekpxdG3pA_SLmEvS-66" value="&lt;b&gt;Version: 1.0.2025.11.20 | &lt;/b&gt;&lt;i&gt;Last Update: 2025-11-20&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="GXKjekpxdG3pA_SLmEvS-49">
