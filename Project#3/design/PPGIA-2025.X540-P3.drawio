        <mxCell id="-QjtrjUzRDEMRZ5MF8oH-48" value="&lt;b&gt;Team B:&amp;nbsp;&lt;/b&gt;&lt;br style=&quot;font-size: 16px&quot;&gt;&lt;div&gt;-&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;Carlos Duarte - matr. 2527530&lt;/span&gt;&lt;/div&gt;&lt;div&gt;- Jonas de A. Luz Jr. - matr. 2519171&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;resizable=0;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=16;" parent="GXKjekpxdG3pA_SLmEvS-49" vertex="1">
