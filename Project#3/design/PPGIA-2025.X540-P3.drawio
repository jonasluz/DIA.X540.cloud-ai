        <mxCell id="7OVz4w7n9kzEPWy-4BBC-13" value="&lt;span&gt;The client endpoint application initiate the conversation session.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="GXKjekpxdG3pA_SLmEvS-65" vertex="1">
