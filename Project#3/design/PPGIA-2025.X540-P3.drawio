          <mxGeometry x="1198" y="310" width="502" height="56.370000000000005" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-50" value="&lt;span&gt;After initialization, the end user application keeps sending the text and audio messages from the user to the service.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" vertex="1" parent="GXKjekpxdG3pA_SLmEvS-52">
          <mxGeometry x="52" width="450" height="56.37" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-51" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;" vertex="1" parent="GXKjekpxdG3pA_SLmEvS-52">
          <mxGeometry y="1.5" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-53" value="" style="group" vertex="1" connectable="0" parent="1">
          <mxGeometry x="1198" y="243.63" width="502" height="56.370000000000005" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-6" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;" parent="GXKjekpxdG3pA_SLmEvS-53" vertex="1">
          <mxGeometry y="1.5" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-15" value="&lt;span&gt;The conversation session state and history are mantained in DynamoDB.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="GXKjekpxdG3pA_SLmEvS-53" vertex="1">
          <mxGeometry x="52" width="450" height="56.37" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-54" value="" style="group" vertex="1" connectable="0" parent="1">
          <mxGeometry x="1199" y="366.37" width="502" height="56.370000000000005" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-55" value="&lt;span&gt;For the audio requests, we use AWS Transcribe to convert from speech to text (STT).&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" vertex="1" parent="GXKjekpxdG3pA_SLmEvS-54">
          <mxGeometry x="52" width="450" height="56.37" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-56" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;" vertex="1" parent="GXKjekpxdG3pA_SLmEvS-54">
          <mxGeometry y="1.5" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-58" value="" style="group" vertex="1" connectable="0" parent="1">
          <mxGeometry x="1198" y="430" width="500.5" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-9" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;" parent="GXKjekpxdG3pA_SLmEvS-58" vertex="1">
          <mxGeometry width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-18" value="&lt;span&gt;All requests are forwarded, as text, to the LLM provided in the Amazon Bedrock service.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="GXKjekpxdG3pA_SLmEvS-58" vertex="1">
          <mxGeometry x="50.5" y="1.5" width="450" height="58.5" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-59" value="" style="group" vertex="1" connectable="0" parent="1">
          <mxGeometry x="1198" y="490" width="500" height="53" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-10" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;" parent="GXKjekpxdG3pA_SLmEvS-59" vertex="1">
          <mxGeometry width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-19" value="&lt;span&gt;The responses from the LLM are converted to audio using the Amazon Polly service.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="GXKjekpxdG3pA_SLmEvS-59" vertex="1">
          <mxGeometry x="51" y="0.5" width="449" height="52.5" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-60" value="" style="group" vertex="1" connectable="0" parent="1">
          <mxGeometry x="1198" y="550" width="499.5" height="45" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-11" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;" parent="GXKjekpxdG3pA_SLmEvS-60" vertex="1">
          <mxGeometry width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-20" value="&lt;span&gt;The audio responses are returned back to the endpoint application.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="GXKjekpxdG3pA_SLmEvS-60" vertex="1">
          <mxGeometry x="50.5" y="1.5" width="449" height="43.5" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-61" value="" style="group" vertex="1" connectable="0" parent="1">
          <mxGeometry x="1198" y="620" width="501.5" height="65" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-12" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;" parent="GXKjekpxdG3pA_SLmEvS-61" vertex="1">
          <mxGeometry width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-21" value="&lt;span&gt;The endoint application executes the audio responses. Once the user close the conversation session, the endpoint application notifies the backend.&amp;nbsp;&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="GXKjekpxdG3pA_SLmEvS-61" vertex="1">
          <mxGeometry x="52.5" y="0.5" width="449" height="64.5" as="geometry" />
        </mxCell>
        <mxCell id="GXKjekpxdG3pA_SLmEvS-62" value="" style="group" vertex="1" connectable="0" parent="1">
          <mxGeometry x="1199.5" y="698" width="501.5" height="49.5" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-22" value="10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;" parent="GXKjekpxdG3pA_SLmEvS-62" vertex="1">
          <mxGeometry width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="7OVz4w7n9kzEPWy-4BBC-23" value="&lt;span&gt;Once the conversation session is closed, its state is concluded in the database.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="GXKjekpxdG3pA_SLmEvS-62" vertex="1">
          <mxGeometry x="52.5" y="0.5" width="449" height="49" as="geometry" />
        </mxCell>
